<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_splash.xml
    Premium, clean splash screen with separate icon and vector rendering.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="@dimen/spacing_large">

    <!-- Center Container for Logo, Name, Tagline -->
    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Standalone Handi Icon -->
        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_handi_logo" />

        <!-- Crisp System Text App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:fontFamily="sans-serif-bold"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="38sp"
            android:textStyle="bold" />

        <!-- Crisp System Text Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:fontFamily="sans-serif-medium"
            android:text="@string/splash_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_subheading" />

    </LinearLayout>

    <!-- Creator Credit -->
    <TextView
        android:id="@+id/txtSplashCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/spacing_large"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:foreground="?android:attr/selectableItemBackground"
        android:text="@string/creator_credit"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_body" />

</RelativeLayout>