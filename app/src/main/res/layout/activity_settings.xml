<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kitchenBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?attr/kitchenPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Settings"
                android:textColor="?attr/kitchenPrimary"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- SECTION 1: Kitchen Themes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="Kitchen Theme"
            android:textColor="?attr/kitchenTextMain"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/kitchenBg"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/kitchenPrimary"
            app:strokeWidth="1dp">

            <RadioGroup
                android:id="@+id/rgThemes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <RadioButton
                    android:id="@+id/rbKesar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="8dp"
                    android:text="Kesar (Saffron Orange)"
                    android:textColor="?attr/kitchenTextMain"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbTulsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="8dp"
                    android:text="Tulsi (Botanical Green)"
                    android:textColor="?attr/kitchenTextMain"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbMitti"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="8dp"
                    android:text="Mitti (Terracotta Brown)"
                    android:textColor="?attr/kitchenTextMain"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbMasala"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="8dp"
                    android:text="Masala (Spiced Crimson)"
                    android:textColor="?attr/kitchenTextMain"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbHaldi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingVertical="8dp"
                    android:text="Haldi (Turmeric Yellow)"
                    android:textColor="?attr/kitchenTextMain"
                    android:textSize="15sp" />

            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: Cooking Assistance -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="Cooking Assistance"
            android:textColor="?attr/kitchenTextMain"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/kitchenBg"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/kitchenPrimary"
            app:strokeWidth="1dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchCookingMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:padding="16dp"
                android:text="Cooking Mode (Keep Screen On)"
                android:textColor="?attr/kitchenTextMain"
                android:textSize="15sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 3: Data Management -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="Data Management"
            android:textColor="?attr/kitchenTextMain"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/kitchenBg"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/kitchenPrimary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportJson"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Export Recipes to JSON"
                    android:textColor="?attr/kitchenBg"
                    app:backgroundTint="?attr/kitchenPrimary"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportJson"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Import Recipes from JSON"
                    android:textColor="?attr/kitchenPrimary"
                    app:cornerRadius="8dp"
                    app:strokeColor="?attr/kitchenPrimary"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearData"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Delete Selected Recipes"
                    android:textColor="#C62828"
                    app:cornerRadius="8dp"
                    app:strokeColor="#C62828"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- SECTION 4: About Us -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="About"
            android:textColor="?attr/kitchenTextMain"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="?attr/kitchenBg"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/kitchenPrimary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutUs"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="About Annapurna"
                    android:textColor="?attr/kitchenPrimary"
                    app:cornerRadius="8dp"
                    app:strokeColor="?attr/kitchenPrimary"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>