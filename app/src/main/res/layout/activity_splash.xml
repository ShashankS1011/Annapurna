<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_splash.xml
    Premium, clean splash screen with theme background and vector rendering.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kitchenBg"
    android:padding="24dp">

    <!-- Center Container for Logo, Name, Tagline -->
    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Standalone Handi Icon -->
        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_handi_logo" />

        <!-- Crisp App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.05"
            android:text="@string/app_name"
            android:textColor="?attr/kitchenPrimary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Crisp Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="@string/splash_tagline"
            android:textColor="?attr/kitchenTextSecondary"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Creator Credit -->
    <TextView
        android:id="@+id/txtSplashCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="8dp"
        android:text="@string/creator_credit"
        android:textColor="?attr/kitchenPrimary"
        android:textSize="14sp" />

</RelativeLayout>
